{
    "name": "beffe",
    "version": "0.0.1",
    "description": "backend for frontend",
    "scripts": {
        "build": "tsc",
        "lint": "eslint src --ext .ts",
        "start": "npm run build && export PORT=1010 && node .build/server.js ",
        "dev": "rm -r .build && source .env && ./node_modules/nodemon/bin/nodemon.js -e ts  --exec \"npm run build && node  --openssl-legacy-provider .build/dev-server.js \"",
        "cert": "bash .sslcert/generate",
        "update-v": "npm version patch && git add package.json && git commit -m \"chore: update package version\" && git push"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.4.8",
        "@types/vhost": "^3.0.9",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "eslint": "^10.0.2",
        "nodemon": "^3.0.1",
        "typescript": "^5.1.6"
    },
    "dependencies": {
        "@bsr-comm/utils": "github:iambriansreed/comm-utils",
        "express": "^4.19.2",
        "google-auth-library": "^9.7.0",
        "google-spreadsheet": "^4.1.1",
        "hcaptcha": "^0.2.0",
        "helmet": "^7.1.0",
        "socket.io": "^4.7.5",
        "vhost": "^3.0.2"
    }
}
